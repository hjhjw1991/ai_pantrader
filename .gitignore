node_modules/
.next/
# PANTRADER_DIST_DIR 另建的产物目录（dev 跑着的时候做生产构建用）
.next-*/
*.db
*.db-journal
*.db-wal
*.db-shm
*.ptbak
tmp/
.DS_Store
*.tsbuildinfo

# 环境变量文件。lib/advisor/claude-api.ts 读 ANTHROPIC_API_KEY，
# 迟早有人会建一个 .env 把 key 写进去 —— 那时它默认是会被 commit 的。
.env
.env.*
!.env.example

# 编辑器/助手的本机配置。settings.local.json 里带绝对路径（含用户名）。
# 本机是靠**全局** gitignore 挡住的（~/.config/git/ignore），
# 那条规则不会跟着仓库走 —— 别人 clone 下来就没有保护了。
.claude/settings.local.json

# 策略实文件不进 git：`持仓:` 段的键就是用户自己的账户 id，那是个人数据。
# 仓库只跟踪去个人化的 config/strategies/*.yaml.example（不匹配下面这条），
# 实文件由 `pnpm seed-strategies` 从模板播种。
#
# 代价是策略的演化史不再能用 git diff 看 —— 载体换成了
# ~/PanTraderData/strategy-backups/：每次写回都留一份 <文件名>.YYYYMMDD-HHmmss，
# 而且天然在 git 之外、随 DB 一起备份，不会被 git clean 或重装项目连带删掉。
config/strategies/*.yaml

# 数据目录放在仓库内的选项（PANTRADER_DATA_DIR 指到 <仓库>/data 时用）。
#
# 默认位置仍然是仓库外的 ~/PanTraderData —— 免费数据源随时会封，攒下的历史
# 是不可再生资产。放进仓库内换来的是"一个目录带走整套东西"，代价要认清楚：
# **.gitignore 挡不住 `git clean -xdf`**，-x 恰恰是"连被忽略的文件一起删"。
# 那条命令是很多人清工作区的习惯动作，在这里会把整个库删掉。
# 所以放仓库内就更要有独立备份（pnpm db:export 生成的 .ptbak 放到别处）。
/data/
